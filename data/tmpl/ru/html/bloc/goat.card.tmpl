<body>
<div id="myModal" class="xmodal">
	<span class="xclose">&times;</span>
	<img class="xmodal-content" id="img_src">
	<div id="xcaption"></div>
</div>
<script>
function popup($img_no) {
	var modal = document.getElementById('myModal');
	var img = document.getElementById('imgs' + $img_no);
	var modalImg = document.getElementById('img_src');
	var captionText = document.getElementById('xcaption');
	var span = document.getElementsByClassName('xclose')[0];
	modal.style.display = 'block';
	modalImg.src = img.src;
	captionText.innerHTML = img.alt;
	span.onclick = function() { modal.style.display = 'none'; }
}
function askName(id, navi, pid, name) {
	var xhttp = new XMLHttpRequest();
	var pname = '';
	xhttp.onreadystatechange = function() {
		if (this.readyState == 4 && this.status == 200) {
			pname = this.responseText;
			navi.innerHTML = '<a onClick="loadTree(' + pid + ')">'
				+ name + '</a>&nbsp;&gt;&gt&nbsp;' + pname;
		}
	};
	xhttp.open('GET', '/api/ajax.php?m=name&id=' + id);
	xhttp.send();
	return name;
}
function loadTree(id) {
	var pid = {{js/pid}};
	var name = '{{js/name}}';
	var navi = document.getElementById('tree_root');
	var xhttp = new XMLHttpRequest();
	if (id != pid) {
		askName(id, navi, pid, name);
	} else {
		navi.innerHTML = name;
	}
	xhttp.onreadystatechange = function() {
		if (this.readyState == 4 && this.status == 200) {
			document.getElementById('dtbl1').innerHTML = this.responseText;
			document.getElementById('target1').scrollIntoView();
		}
	};
	xhttp.open('GET', '/api/ajax.php?m=tree&id=' + id + '&pid=' + pid);
	xhttp.send();
}
</script>
