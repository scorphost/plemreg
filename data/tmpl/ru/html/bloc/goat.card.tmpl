<script>
function getInvite(id) {
	var xhttp = new XMLHttpRequest();
	var hrs = document.getElementById('invite_hrs').value;
	var gens = document.getElementById('invite_gens').value;


	xhttp.onreadystatechange = function() {
		if (this.readyState == 4 && this.status == 200) {
			var url = this.responseText;
			var r = document.getElementById('invite_url');
			r.value = url;
		}
	};
	xhttp.open('GET', '/api/ajax.php?m=invite&id='
	 + id + '&h=' + hrs + '&g=' + gens);
	xhttp.send();
	return url;

}
</script>
{{&is_admin%%<hr />
<p><b>Инвайт на эту страницу:</b> На сколько часов: <input style="width: 30px;" type="text" id="invite_hrs" value="1" /> Поколений: <input style="width: 30px;" type="text" id="invite_gens" value="2" /><br />
<p><input style="width: 500px;" type="text" id="invite_url" value="" /></p>
<input id="invite_url"  onClick="getInvite({{js/pid}})" type="button" value="Получить" /></p>
}}
